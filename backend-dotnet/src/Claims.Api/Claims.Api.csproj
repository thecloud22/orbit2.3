<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Claims.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Temporalio" Version="1.20.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Determinism guard for workflow code (see BannedSymbols.txt). -->
    <AdditionalFiles Include="..\..\BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Flyway SQL files, unchanged. DbUp runs them in name order. -->
    <EmbeddedResource Include="Migrations\Scripts\*.sql" />
    <EmbeddedResource Include="Migrations\Scripts\Dev\*.sql" />
  </ItemGroup>

</Project>
